    {
      "name": "Sistema Interconectado Nacional",
      "short": "SIN",
      "detail": "Comprende las regiones Central, Oriental, Occidental, Noroeste, Norte, Noreste y Peninsular. No incluye Baja California, Baja California Sur ni Mulegé."
    },
    {
      "name": "Sistema Interconectado Baja California",
      "short": "SIBC",
      "detail": "Distinto del SIN; el PRODESEN reporta conexión con WECC (Estados Unidos) por dos líneas de 230 kV de corriente alterna. Esto no lo conecta al SIN."
    },
    {
      "name": "Sistema Interconectado Baja California Sur",
      "short": "SIBCS",
      "detail": "Opera eléctricamente aislado del SIN, SIBC y Mulegé según PRODESEN 2024-2038, Anexo 1."
    },
    {
      "name": "Sistema Interconectado Mulegé",
      "short": "SIMUL",
      "detail": "Pequeño sistema separado de los demás; su centro de control se ubica en Santa Rosalía, según PRODESEN 2024-2038."
    }
  ],
